# Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# MongoDB Atlas connection string (get from Atlas dashboard -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>
MONGODB_DB_NAME=jwt_setup

# Which email backend to use: "smtp" today, "ses" later (see app/email/ses.py)
EMAIL_PROVIDER=smtp

# SMTP (used to send forgot-password OTP emails)
# For Gmail: use an "App password" (Google Account -> Security -> App passwords), not your login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=replace-with-an-app-password
SMTP_FROM_EMAIL=your-address@gmail.com
SMTP_FROM_NAME=App
OTP_EXPIRE_MINUTES=10
